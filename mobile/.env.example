# Base URL of the backend.
# - iOS simulator / web: http://localhost:4000
# - Android emulator:    http://10.0.2.2:4000  (localhost is auto-rewritten to this on Android)
# - Physical device:     http://<your-computer-LAN-IP>:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Optional: open a specific competition / act as a specific user instead of the demo defaults.
# EXPO_PUBLIC_COMPETITION_ID=
# EXPO_PUBLIC_USER_ID=
