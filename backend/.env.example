# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# --- MongoDB ---
MONGODB_URI=mongodb://127.0.0.1:27017/feedants

# --- Business rules ---
# Minutes a spot is held while the user completes payment
HOLD_MINUTES=10
# Show "Hurry up!" when registration closes within this many hours
HURRY_THRESHOLD_HOURS=48

# --- Payments ---
# mock     -> no external calls, the app shows a simulated payment sheet
# razorpay -> real Razorpay Orders API (needs the three vars below)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Referral ---
REFERRAL_BASE_URL=https://feedants.com/r
REFERRAL_REWARD_INR=10

# --- Demo helpers (never enable in production) ---
ENABLE_DEV_ROUTES=true
